+  color: #b8b5ae;
+  margin-top: 7px;
+}
+dl > div {
+  display: flex;
+  justify-content: space-between;
+  gap: 12px;
+  margin: 15px 0;
+}
+dd {
+  margin: 0;
+}
+.total {
+  border-top: 1px solid #534c3d;
