+  "http://checkout.paystack.com/a",
+  "https://checkout.paystack.com.evil/a",
+  "https://user:password@checkout.paystack.com/a",
+  "javascript:alert(1)",
+])
+  test(`rejects redirect ${u}`, () => assert.equal(authorizationOK(u), false));
