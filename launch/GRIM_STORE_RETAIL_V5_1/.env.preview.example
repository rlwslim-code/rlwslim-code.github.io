# Configure these only for Vercel Preview, preferably scoped to grim-payment-repair-test.
GRIM_CHECKOUT2_ENABLED=true
GRIM_CHECKOUT2_DB_ISOLATED=true
GRIM_CHECKOUT2_SUPABASE_URL=https://YOUR-TEST-PROJECT.supabase.co
GRIM_CHECKOUT2_SUPABASE_SERVICE_ROLE_KEY=YOUR-TEST-SERVICE-ROLE-KEY
GRIM_CHECKOUT2_PAYSTACK_SECRET_KEY=sk_test_YOUR_TEST_KEY
SESSION_SECRET=YOUR_PREVIEW_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Vercel supplies VERCEL_ENV=preview and VERCEL_URL automatically.
# Production SUPABASE_URL must never equal the checkout test URL.
